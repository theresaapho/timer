{
  "name": "turntimer-pro",
  "version": "1.2.0",
  "description": "Professional Hybrid Turn Timer featuring WakeLock, Pause, TimeBank, and Auto-Pass",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron . --no-sandbox",
    "package-win": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.turntimer.pro",
    "productName": "TurnTimerPro",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}