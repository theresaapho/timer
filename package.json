{
  "name": "timer",
  "version": "1.0.0",
  "description": "Multiplayer Game Timer Platform",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron . --no-sandbox",
    "package-win": "electron-builder --win portable",
    "package-linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.timer.app",
    "productName": "Timer",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}